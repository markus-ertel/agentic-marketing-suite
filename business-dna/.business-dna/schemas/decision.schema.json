{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business-DNA Decision v0.1",
  "type": "object",
  "required": [
    "decision_id",
    "decision",
    "decider",
    "decided_at",
    "claim_refs"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "decider": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confirmation_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
