{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business-DNA Context Pack v0.1",
  "type": "object",
  "required": [
    "request_id",
    "requester",
    "purpose",
    "generated_at",
    "as_of",
    "claims",
    "sources",
    "excluded_count",
    "limitations"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "requester": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "excluded_count": {
      "type": "integer",
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
