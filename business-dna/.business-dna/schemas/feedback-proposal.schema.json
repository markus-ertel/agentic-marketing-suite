{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewable External Feedback Proposal v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "created_at",
    "origin",
    "sources",
    "claims",
    "base_claim_sha256",
    "base_source_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "type": "object",
      "required": [
        "kind",
        "usage_review_ref",
        "deidentification_review_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "conversation_note",
            "recording_transcript",
            "feedback_document"
          ]
        },
        "usage_review_ref": {
          "type": "string",
          "minLength": 1
        },
        "deidentification_review_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "source.schema.json"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "claim.schema.json"
      }
    },
    "base_claim_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "base_source_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "additionalProperties": false
}
